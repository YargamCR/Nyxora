* {
    bg: #17191f;
    bg-alt: #20232b;
    fg: #d8dbe2;
    accent: #a6b4a0;
    background-color: @bg;
    text-color: @fg;
    border-color: @accent;
}
window {
    width: 38%;
    padding: 22px;
    border: 1px;
    border-radius: 10px;
    border-color: @border-color;
    background-color: @bg;
}
mainbox { spacing: 14px; background-color: transparent; }
inputbar { padding: 10px 12px; background-color: @bg-alt; border-radius: 7px; }
prompt { text-color: @accent; }
entry { text-color: @fg; placeholder: "Search applications…"; }
listview { lines: 8; spacing: 4px; fixed-height: false; background-color: transparent; }
element { padding: 9px 10px; border-radius: 6px; }
element selected { background-color: @bg-alt; text-color: @accent; }
element-text { background-color: transparent; }
