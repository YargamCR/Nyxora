configuration {
    modi: "drun,run,window";
    show-icons: true;
    drun-display-format: "{name}";
    display-drun: "Apps";
    display-run: "Run";
    display-window: "Windows";
    font: "JetBrainsMono Nerd Font 10";
    matching: "fuzzy";
    sort: true;
    disable-history: false;
    sidebar-mode: false;
}
@theme "theme.rasi"
